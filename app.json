{
  "expo": {
    "name": "Outlyride",
    "slug": "outlyride-expo-go",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-transparent.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Outlyride to find your city for local events and rides. / Autorisez Outlyride à trouver votre ville pour les événements et trajets locaux."
        }
      ]
    ],
    "ios": {
      "icon": "./assets/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.outlyride.expogo"
    },
    "android": {
      "icon": "./assets/logo-transparent.png",
      "package": "com.outlyride.expogo",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#EAF7ED",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
